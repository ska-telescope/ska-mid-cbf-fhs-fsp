@startuml rdt_operation
!pragma teoz true

title Resampler/Delay Tracker Device Operation

!$MCSLifeline = "#DDDDEE"
!$FHSFSPBackground = "#f0dbb7"
!$FSPCtrl = "#ffe680"
!$FSPCtrlLifeline = "#ffe680"
!$LowLevelDSBackground = "#cbecec"
!$LowLevelDS = "#99e6ff"
!$LowLevelDSLifeline = "#99e6ff"
!$LowLevelQ = "#78d0ed"
!$LowLevelQLifeline = "#78d0ed"
!$FWBackground = "#ffddee"
!$FWParticipant = "#f4aacc"
!$FWLifeline = "#f4aacc"

box "FHS-FSP" $FHSFSPBackground
box "Resampler/Delay Tracker Device Server" $LowLevelDSBackground
participant "RDT Component Manager" as rdt_cm $LowLevelDS
participant "FODM Gen Library" as fodm_gen $LowLevelDS
queue "HO FIFO (Deque)" as ho_fifo $LowLevelQ
queue "FO FIFO (Deque)" as fo_fifo $LowLevelQ
end box
end box
box "Resampler/Delay Tracker FW" $FWBackground
participant "RDT Driver" as rdt_driver $FWParticipant
participant "RDT IP" as rdt_ip $FWParticipant
end box

loop until error or force stop
  loop until (fodm_buffer_depth - fodm_space_available) < fo_fill_threshold
    rdt_cm -> rdt_driver ++ $FWLifeline: status()
    rnote right of rdt_cm
      current_time: 1742500234.0
      running: True
      error_code: 0
      fodm_space_available: 3333
    endrnote
    rdt_cm <-- rdt_driver --
  end

  group if [len(fo_fifo) > 0]
    rdt_cm -> rdt_cm: Create array FODMs_to_load
    loop while len(fo_fifo) > 0 and len(FODMs_to_load) <= fodm_space_available
      rdt_cm -> fo_fifo ++ $LowLevelQLifeline: pop()
      rdt_cm <-- fo_fifo --: FODM
      rdt_cm -> fodm_gen ++ $LowLevelDSLifeline: CalcFodmRegisterValues(FODM)
      rdt_cm <-- fodm_gen --: register_values
      rdt_cm -> rdt_cm: FODMs_to_load.append(register_values)
    end
    rdt_cm -> rdt_driver ++ $FWLifeline: load_fodm(FODMs_to_load)
    rdt_cm <-- rdt_driver --: fodm_space_available
  end

  loop while len(ho_fifo) > 0 and fodm_space_available > 0
    rdt_cm -> ho_fifo ++ $LowLevelQLifeline: pop()
    rdt_cm <-- ho_fifo --: HODM
    rdt_cm -> rdt_cm: Check HODM stop timestamp OK
    group if [HODM timestamp is OK]

      rdt_cm -> fodm_gen ++ $LowLevelDSLifeline: process(HODM)
      rdt_cm <-- fodm_gen --: FODM_array
      rdt_cm -> rdt_cm: Remove FODMs from FODM_array with invalid timestamps

      group if [len(FODM_array) > 0]
        rdt_cm -> rdt_cm: Create array FODMs_to_load
        loop for FODM in FODM_array
          rdt_cm -> fodm_gen ++ $LowLevelDSLifeline: CalcFodmRegisterValues(FODM)
          rdt_cm <-- fodm_gen --: register_values

          group if [len(FODMs_to_load) < fodm_space_available]
            rdt_cm -> rdt_cm: FODMs_to_load.append(register_values)
          else len(FODMs_to_load) >= fodm_space_available
            rdt_cm -> fo_fifo ++ $LowLevelQLifeline: put(register_values)
            rdt_cm <-- fo_fifo --
          end
        end

        rdt_cm -> rdt_driver ++ $FWLifeline: load_fodm(FODMs_to_load)
        rdt_cm <-- rdt_driver --: fodm_space_available
      end
    end
  end
end

@enduml
